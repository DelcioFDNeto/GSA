# Banco de dados — SQLite para desenvolvimento (padrão)
GSA_DATABASE_URL=sqlite:///./gsa.db
# PostgreSQL (produção):
# GSA_DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/gsa

# Segurança (RNF07) — gere valores próprios, por exemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sem GSA_JWT_SEGREDO a API gera um segredo aleatório a cada início (tokens expiram ao reiniciar).
GSA_JWT_SEGREDO=
GSA_JWT_EXPIRACAO_MINUTOS=60
# Chave enviada pelo sistema de detecção no cabeçalho X-API-Key
GSA_CHAVE_API_DETECCAO=

# Valores iniciais dos parâmetros do algoritmo (depois são alterados por PUT /parametros)
GSA_DURACAO_CICLO_PADRAO=90
GSA_LIMITE_FLUXO_BAIXO=5
GSA_LIMITE_FLUXO_MODERADO=15
GSA_LIMITE_FLUXO_ALTO=25
GSA_VERDE_MINIMO_PADRAO=15
GSA_VERDE_MAXIMO_PADRAO=60
GSA_TEMPO_MAXIMO_SEM_LEITURA=300
# Regra de Webster: fluxo de saturação (veíc/h por faixa), segundos cobertos por contagem e
# limites do ciclo calculado
GSA_FLUXO_SATURACAO_POR_FAIXA=1800
GSA_INTERVALO_CONTAGEM=90
GSA_CICLO_MINIMO=40
GSA_CICLO_MAXIMO=150

# Intervalo da verificação automática de falhas, em segundos (0 desativa)
GSA_INTERVALO_VERIFICACAO_FALHAS=60

# Simulador visual de tráfego em /simulador — SOMENTE DEMONSTRAÇÃO: envia leituras sintéticas
# com a chave do sistema de detecção, sem pedir login. Prefira "python -m simulador", que liga o
# simulador em um banco separado (gsa_simulador.db). Sem URL, fala com esta mesma API.
# GSA_SIMULADOR_HABILITADO=0
# GSA_SIMULADOR_API_URL=

# Contêiner: porta e dados de demonstração (usados no deploy do Render)
# PORT=8000
# GSA_SEED_AO_INICIAR=1
# GSA_SEED_SENHA_ADMIN=
# GSA_SEED_SENHA_OPERADOR=
